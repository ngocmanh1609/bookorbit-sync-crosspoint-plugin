{
  "title": "BookOrbit",
  "description": "Browse and download your BookOrbit library. Set up on the reader's Plugins web page.",
  "config": { "file": "/.cp-orbit/config.json" },
  "browse": {
    "format": "json",
    "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books?libraryId={list_id_enc}&sort=title&format=epub&page={page}&size={limit}",
    "headers": { "x-auth-user": "{cfg.user}", "x-auth-key": "{cfg.key}", "accept": "application/json" },
    "items": "items",
    "fields": { "title": "title", "author": "authors.0", "id": "id" },
    "page_size": 8,
    "lists": [
      { "title": "Continue reading", "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books?readStatus=reading&sort=recently_read&order=desc&format=epub&page={page}&size={limit}" },
      { "title": "Recently added", "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books?sort=recently_added&order=desc&format=epub&page={page}&size={limit}" },
      { "title": "Not started", "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books?readStatus=unread&sort=recently_added&order=desc&format=epub&page={page}&size={limit}" },
      { "title": "Finished", "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books?readStatus=finished&sort=recently_read&order=desc&format=epub&page={page}&size={limit}" },
      { "title": "All books", "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books?sort=title&format=epub&page={page}&size={limit}" }
    ],
    "lists_url": "{cfg.server}/api/v1/koreader/plugin/catalog/sections/libraries",
    "lists_headers": { "x-auth-user": "{cfg.user}", "x-auth-key": "{cfg.key}", "accept": "application/json" },
    "lists_items": "items",
    "lists_fields": { "title": "title", "id": "id" },
    "search": { "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books?q={query}&format=epub&page={page}&size={limit}" }
  },
  "download": {
    "url": "{cfg.server}/api/v1/koreader/plugin/catalog/books/{id_enc}?deviceId={cfg.device_id}",
    "headers": { "x-auth-user": "{cfg.user}", "x-auth-key": "{cfg.key}", "accept": "application/json" },
    "url_path": "files.0.downloadUrl",
    "dest_dir": "/Books/BookOrbit",
    "filename": "{title} - {author}.epub",
    "sidecar": { "path": "{dest}.meta.json", "body": "{\"bookorbit_book_id\":\"{id}\",\"source\":\"bookorbit\"}" }
  },
  "events": {
    "reader.session": {
      "request": {
        "method": "POST",
        "url": "{cfg.server}/api/v1/koreader/plugin/page-stats",
        "headers": { "Content-Type": "application/json", "x-auth-user": "{cfg.user}", "x-auth-key": "{cfg.key}" },
        "body": "{\"deviceId\":\"{cfg.device_id}\",\"deviceModel\":\"CrossPoint\",\"pluginVersion\":\"cp-orbit/0.3.0\",\"books\":[{\"hash\":\"{event.document}\",\"events\":[{\"page\":{event.start_progress_bp},\"startTime\":{event.start_time},\"durationSeconds\":{event.duration_seconds},\"totalPages\":10000},{\"page\":{event.end_progress_bp},\"startTime\":{event.end_time},\"durationSeconds\":0,\"totalPages\":10000}]}]}"
      },
      "connect": true,
      "toast": "BookOrbit: reading session sent"
    }
  }
}
